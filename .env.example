# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.
# Every key is optional: without it the site still works and uses placeholder data for that feature.

# GitHub skyline + streak plant. Fine-grained PAT: public repos, read-only, no permissions.
GITHUB_TOKEN=
GITHUB_USERNAME=kuagabriel8

# Contact form → email (resend.com). Without a verified domain, Resend only delivers to your own signup email.
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Spotify now playing (v1.1). Developer app + one-time login for the refresh token.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
